{
  "name": "dsh-deepspace-theme",
  "version": "0.1.0",
  "description": "Deep-space glassmorphism (comet blue / indigo over a dark sky) theme for DeepSeek Harness Web GUI. Token-override client plugin — safe: no build-time hash class names, so it keeps working across dsh frontend upgrades.",
  "type": "module",
  "license": "MIT",
  "main": "bundle/host.js",
  "exports": {
    ".": "./bundle/host.js",
    "./client": "./bundle/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "bundle",
    "assets",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "deepspace",
    "glassmorphism"
  ]
}
